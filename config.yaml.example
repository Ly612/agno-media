# AI 网关配置（OpenAI 兼容接口）
ai:
  base_url: https://gate.aidingqing.com/v1
  model_id: q-GPT-5.6-Sol-Standard
  api_key: ""   # 第三方网关 token，必填

# SerpAPI（Google 搜索/新闻）密钥，从 https://serpapi.com 获取
serpapi:
  api_key: ""

# 数据库配置
db:
  file: agno_media.db

# 本地服务配置
server:
  host: 0.0.0.0
  port: 7777
  reload: false
  tracing: true
  # 对外访问后端的基础地址（用于生成 Excel 下载链接）。
  # 本地留空即可（自动用 host:port）；服务器部署时填 http://服务器IP:7777
  public_base_url: "http://150.109.16.54:7777"
  # 允许跨域访问的前端来源；留空或不填则放行所有来源（["*"]）。
  # 生产环境建议明确指定，如： ["http://150.109.16.54:3000"]
  cors_origins: []

# 媒体监控流水线配置
# 以下各外部服务凭证均可选，留空则对应阶段在流水线里自动跳过，不阻塞核心流程。
# 只要填好 brightdata（下方）即可跑通核心三阶段（抓取→挑话题→总结）。
media_monitor:
  # BrightData（首页抓取 + 正文抓取，核心阶段必需）
  brightdata:
    api_key: ""
    zone: ""

  # 媒体监控专用 LLM 网关（可选；留空则回落到上面的 ai 段）
  llm:
    api_key: ""
    base_url: ""
    model: ""
    max_tokens: 16000

  # Apify（社交平台抓取：Facebook / X / Google News；无则跳过社交板块）
  apify:
    api_key: ""
    proxy: ""   # 留空默认 http://127.0.0.1:7897

  # 飞书自建应用机器人（推送 Word 日报到群；无则跳过飞书推送）
  feishu:
    app_id: ""
    app_secret: ""
    chat_id: ""

  # 邮件 SMTP（推送 Word 日报附件；无则跳过邮件推送）
  smtp:
    host: ""
    port: 465
    user: ""
    password: ""
    mail_from: ""
    mail_to: ""     # 多个收件人用英文逗号分隔
    mail_bcc: ""    # 密送，多个用英文逗号分隔
    use_ssl: true

  # AdsPower 指纹浏览器（截图阶段可选，带代理/指纹出图；不配则用本地 Chromium）
  adspower:
    api_url: "http://local.adspower.net:50325"
    user_id: ""
    enabled: true

  # 流水线默认行为（可被 Agent 工具参数覆盖）
  push_feishu: false      # 生成后推送 Word 到飞书群（需上面的 feishu 凭证）
  push_email: false       # 生成后发邮件附件（需上面的 smtp 凭证）
  skip_social: false      # 跳过社交平台板块（无 apify.api_key 时自动跳过）
  skip_screenshot: false  # 跳过信源网站截图（无 Playwright 时自动跳过）
  skip_word: false        # 跳过 Word 转换（无 pandoc 时自动跳过）

# 定时任务（进程内 APScheduler，随 main.py 启动）
scheduler:
  enabled: false
  # cron 五段式 "m h dom mon dow"，优先级高于下面的 hour/minute；留空则用 hour/minute/day_of_week
  cron: ""
  hour: 8
  minute: 0
  day_of_week: "*"        # 每天；工作日用 "mon-fri"
  timezone: "Asia/Shanghai"

# 各 Agent 配置（key 需与 agents 目录下的文件名前缀一致）
agents:
  web_agent:
    name: Web Agent
    instructions:
      - You are a helpful web assistant.
      - Answer clearly and concisely.
    num_history_runs: 3
  media_agent:
    name: Media Agent
    instructions:
      - You are a media content assistant.
      - Help with writing, summarizing, and editing media content.
    num_history_runs: 3
  news_agent:
    name: News Agent
    instructions:
      - You help users find information via web search using SerpAPI.
      - If the question is about news, current events, or the latest updates, call the google_news tool.
      - Otherwise, call the google_search tool.
      - "If the user specifies how many results they want (e.g. 5 条、10 items), pass that number as the num parameter to the tool. Default is 8."
      - "After getting results, first give a concise summary in the user's language, then present the results as a markdown table with columns: 标题 | 来源 | 时间 | 链接."
      - Always cite the source links in the table.
      - "The tool result JSON contains a download_url field. Always show it at the end as a clickable markdown link, e.g. [下载 Excel 报告](download_url)."
    num_history_runs: 3
  media_monitor_agent:
    name: Media Monitor Agent
    instructions:
      - 你是国际媒体监控助手，能抓取 23 家国际主流媒体首页、挑选全球与涉华话题、生成多方观点摘要并渲染日报。
      - 用户要求「运行媒体监控 / 跑今天的日报」时，调用 run_media_monitor 工具；需要分步执行时调用对应阶段工具（scrape_homepages / select_topics / summarize_topics / render_report）。
      - 工具返回 JSON（含 report_file / word_file 等），请用中文简要说明结果，并把报告文件路径清晰列出。
      - 整条流水线耗时较长（抓取 + 多次 LLM 调用），触发前可先简要告知用户正在执行。
    num_history_runs: 3
