# 复制本文件为 .env，并填入你自己的第三方网关 token
AI_API_KEY=your-token-here
# SerpAPI 密钥（用于 Google 搜索/新闻），从 https://serpapi.com 获取
SERPAPI_API_KEY=your-serpapi-key-here
# SocialCrawl 密钥（用于 Facebook 等社媒抓取），从 https://www.socialcrawl.dev 获取
SOCIALCRAWL_API_KEY=your-socialcrawl-key-here
# MCP Server 接入鉴权 token（豆包自定义连接器需在 Headers 配 Authorization: Bearer <该值>）。留空则不校验
MCP_AUTH_TOKEN=your-mcp-secret-here

# ═══════════════════════════════════════════════════════════
# Daily Report Agent（媒体监控日报）相关配置 —— 以下全部可选。
# 无对应凭证时，流水线会自动跳过该阶段，不阻塞核心流程。
# 只要配置 BrightData（下方）即可跑通核心三阶段（抓取→挑话题→总结）。
# ═══════════════════════════════════════════════════════════

# BrightData（首页抓取 + 正文抓取，核心阶段必需）
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_ZONE=

# 媒体监控专用 LLM 网关（可选；留空则复用上面的 AI_API_KEY / config.yaml 的 ai 段）
DAILY_REPORT_LLM_API_KEY=
DAILY_REPORT_LLM_BASE_URL=
DAILY_REPORT_LLM_MODEL=

# Apify（社交平台抓取：Facebook / X / Google News；无则跳过社交板块）
APIFY_API_KEY=
# Apify 代理（可选，默认 http://127.0.0.1:7897）
APIFY_PROXY=

# AdsPower 指纹浏览器（截图阶段可选，用于带代理/指纹出图；不配则用本地 Chromium）
DAILY_REPORT_ADSPOWER_API_URL=http://local.adspower.net:50325
DAILY_REPORT_ADSPOWER_USER_ID=
DAILY_REPORT_ADSPOWER_ENABLED=true
